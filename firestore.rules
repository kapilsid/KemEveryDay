rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validName(name) {
      return name is string
        && name.size() >= 3
        && name.size() <= 16
        && name.matches('^[A-Za-z0-9 ]+$');
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly(['displayName', 'normalizedName', 'updatedAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.normalizedName == request.resource.data.displayName.lower()
        && request.resource.data.updatedAt == request.time;
    }

    // The score document's date must be today or yesterday in UTC (allows a run that ends just after midnight).
    function recentUtcDate(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isRecent(timestamp.date(int(date.split('-')[0]), int(date.split('-')[1]), int(date.split('-')[2])));
    }

    function isRecent(day) {
      return day <= request.time && day + duration.value(2, 'd') > request.time;
    }

    // Current UTC week, plus a short grace period immediately after its Sunday ends.
    function recentUtcWeek(weekStart) {
      return weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isRecentWeek(timestamp.date(int(weekStart.split('-')[0]), int(weekStart.split('-')[1]), int(weekStart.split('-')[2])));
    }

    function isRecentWeek(start) {
      return start <= request.time && start + duration.value(8, 'd') > request.time;
    }

    // Mirrors ChampionLimits in ScienceLeaderboardGateway.kt: 20 board moves, at most 130 points for a
    // first find and 30 for a repeat, at most 3 Science Uncovered mysteries a day and 175 points per solved mystery (base, perfect and life bonuses).
    function validChampionScore(uid, date) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'displayName', 'score', 'moleculeScore', 'scienceScore', 'uniqueDiscoveries',
          'mysteriesSolved', 'contentVersion', 'submittedAt', 'verified'
        ])
        && d.keys().hasAll([
          'displayName', 'score', 'moleculeScore', 'scienceScore', 'uniqueDiscoveries',
          'mysteriesSolved', 'contentVersion', 'submittedAt', 'verified'
        ])
        && recentUtcDate(date)
        && d.displayName == get(/databases/$(database)/documents/players/$(uid)).data.displayName
        && d.uniqueDiscoveries is int && d.uniqueDiscoveries >= 0 && d.uniqueDiscoveries <= 20
        && d.moleculeScore is int && d.moleculeScore >= 0
        && ((d.uniqueDiscoveries == 0 && d.moleculeScore == 0)
          || (d.uniqueDiscoveries > 0
            && d.moleculeScore <= d.uniqueDiscoveries * 130 + (20 - d.uniqueDiscoveries) * 30))
        && d.mysteriesSolved is int && d.mysteriesSolved >= 0 && d.mysteriesSolved <= 3
        && d.scienceScore is int && d.scienceScore >= 0
        && d.scienceScore <= d.mysteriesSolved * 175
        && d.score == d.moleculeScore + d.scienceScore
        && d.contentVersion is int && d.contentVersion >= 1
        && d.submittedAt == request.time
        && d.verified == false;
    }

    function validWeeklyChampion(uid, weekStart) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'displayName', 'score', 'moleculeScore', 'scienceScore', 'daysPlayed',
          'uniqueDiscoveries', 'mysteriesSolved', 'contentVersion', 'updatedAt', 'verified'
        ])
        && d.keys().hasAll([
          'displayName', 'score', 'moleculeScore', 'scienceScore', 'daysPlayed',
          'uniqueDiscoveries', 'mysteriesSolved', 'contentVersion', 'updatedAt', 'verified'
        ])
        && recentUtcWeek(weekStart)
        && d.displayName == get(/databases/$(database)/documents/players/$(uid)).data.displayName
        && d.daysPlayed is int && d.daysPlayed >= 1 && d.daysPlayed <= 7
        && d.uniqueDiscoveries is int && d.uniqueDiscoveries >= 0
        && d.uniqueDiscoveries <= d.daysPlayed * 20
        && d.moleculeScore is int && d.moleculeScore >= 0
        && ((d.uniqueDiscoveries == 0 && d.moleculeScore == 0)
          || (d.uniqueDiscoveries > 0
            && d.moleculeScore <= d.uniqueDiscoveries * 130 + (d.daysPlayed * 20 - d.uniqueDiscoveries) * 30))
        && d.mysteriesSolved is int && d.mysteriesSolved >= 0
        && d.mysteriesSolved <= d.daysPlayed * 3
        && d.scienceScore is int && d.scienceScore >= 0
        && d.scienceScore <= d.mysteriesSolved * 175
        && d.score == d.moleculeScore + d.scienceScore
        && d.contentVersion is int && d.contentVersion >= 1
        && d.updatedAt == request.time
        && d.verified == false;
    }

    match /players/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile();
      allow delete: if false;
    }

    match /daily_champions/{date}/players/{uid} {
      allow read: if signedIn();
      // A player may join after either game, then increase the same entry by completing the other.
      allow create: if signedIn() && request.auth.uid == uid && validChampionScore(uid, date);
      allow update: if signedIn()
        && request.auth.uid == uid
        && validChampionScore(uid, date)
        && resource.data.verified == false
        && request.resource.data.moleculeScore >= resource.data.moleculeScore
        && request.resource.data.scienceScore >= resource.data.scienceScore
        && request.resource.data.uniqueDiscoveries >= resource.data.uniqueDiscoveries
        && request.resource.data.mysteriesSolved >= resource.data.mysteriesSolved
        && request.resource.data.contentVersion >= resource.data.contentVersion
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    match /weekly_champions/{weekStart}/players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validWeeklyChampion(uid, weekStart);
      allow update: if signedIn()
        && request.auth.uid == uid
        && validWeeklyChampion(uid, weekStart)
        && resource.data.verified == false
        && request.resource.data.moleculeScore >= resource.data.moleculeScore
        && request.resource.data.scienceScore >= resource.data.scienceScore
        && request.resource.data.uniqueDiscoveries >= resource.data.uniqueDiscoveries
        && request.resource.data.mysteriesSolved >= resource.data.mysteriesSolved
        && request.resource.data.daysPlayed >= resource.data.daysPlayed
        && request.resource.data.contentVersion >= resource.data.contentVersion
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
