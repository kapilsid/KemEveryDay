    <string name="hunt_rules_title">Ìwákiri Mọ́lẹ́kúlù — Òfin</string>
    <string name="hunt_rules_subtitle">Kọ́ àkójọpọ̀ kẹ́míkà gidi lórí pátákó 5 × 5</string>
    <string name="hunt_rule_1">So àwọn átọ̀mù tó wà lẹ́gbẹ̀ẹ́ ara wọn pọ̀ ní ìbú, ní òòró tàbí ní ìkọrí.</string>
    <string name="hunt_rule_2">Lo átọ̀mù 2–6 fún ọ̀pọ̀ àwárí; àwọn fọ́múlà gíga lè lo 7.</string>
    <string name="hunt_rule_3">Tẹ Ṣàwárí láti yẹ àkójọpọ̀ wò. Bí o ṣe yàn wọ́n tẹ̀léra kò yí fọ́múlà padà.</string>
    <string name="hunt_rule_4">Èròjà tí a mọ̀ ń fún ọ ní àmì, ó ń lo ìgbésẹ̀ kan, ó sì ń yọ àwọn táìlì tí o yàn kúrò.</string>
    <string name="hunt_rule_5">Àwọn átọ̀mù ń jábọ́ sílẹ̀, àwọn tuntun tó dọ́gba sì ń wọlé láti òkè.</string>
    <string name="hunt_rule_6">Wá èròjà 10 tó yàtọ̀ síra láti parí iṣẹ́ náà.</string>
    <string name="hunt_rule_7" formatted="false">Àtúnṣe-rírí gbà, ó ń lo ìgbésẹ̀ kan, ó sì ń fún ọ ní 25% àmì, ṣùgbọ́n kò ní fi kún iye èròjà tó yàtọ̀.</string>
    <string name="hunt_rule_8">Àwọn àkópọ̀ tí a kò tíì mọ̀ kò ní lo ìgbésẹ̀, a ó sì fi wọ́n pamọ́ fún Àyẹ̀wò Àwárí.</string>
    <string name="hunt_rule_9">Ìtọ́ka àti Dàrú kò lo ìgbésẹ̀ lọ́wọ́lọ́wọ́.</string>
    <string name="hunt_rule_10">Lẹ́yìn tí o bá parí iṣẹ́ náà, máa ṣàwárí pẹ̀lú ìgbésẹ̀ tó kù.</string>
    <string name="hunt_scoring">Bí a ṣe ń ka àmì</string>
    <string name="hunt_scoring_formula">Àmì = 5 + 5A + 5E + R + S</string>
    <string name="hunt_scoring_legend">A = átọ̀mù · E = ẹ́lẹ́mẹ́ǹtì tó yàtọ̀ · R = àìwọ́pọ̀ (0–40) · S = àwárí tuntun léraléra (0–15)</string>
    <string name="hunt_formula_note">Fọ́múlà ń ṣàpèjúwe àkójọpọ̀, kì í ṣe ìgbékalẹ̀ kan ṣoṣo dandan. Fún àpẹẹrẹ, C₂H₆O lè dúró fún ju èròjà kan lọ.</string>
