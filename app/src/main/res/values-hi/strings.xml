    <string name="hunt_rules_title">मॉलिक्यूल हंट — नियम</string>
    <string name="hunt_rules_subtitle">5 × 5 बोर्ड पर असली रासायनिक यौगिक बनाएँ</string>
    <string name="hunt_rule_1">पास वाले परमाणुओं को आड़ा, खड़ा या तिरछा जोड़ें।</string>
    <string name="hunt_rule_2">ज़्यादातर खोजों में 2–6 परमाणु लगते हैं; कठिन सूत्रों में 7 भी हो सकते हैं।</string>
    <string name="hunt_rule_3">संरचना जाँचने के लिए खोजें दबाएँ। चुनने का क्रम सूत्र नहीं बदलता।</string>
    <string name="hunt_rule_4">पहचाना गया पदार्थ पॉइंट देता है, एक चाल लेता है और चुनी गई टाइलें हटा देता है।</string>
    <string name="hunt_rule_5">परमाणु नीचे गिरते हैं और ऊपर से संतुलित नए परमाणु आते हैं।</string>
    <string name="hunt_rule_6">मिशन पूरा करने के लिए 10 अलग-अलग पदार्थ खोजें।</string>
    <string name="hunt_rule_7" formatted="false">दोहराना मना नहीं है: इसमें एक चाल लगती है और 25% स्कोर मिलता है, पर यूनिक गिनती नहीं बढ़ती।</string>
    <string name="hunt_rule_8">जो जोड़ अभी पहचाने नहीं गए, उनमें चाल नहीं लगती और वे खोज समीक्षा के लिए सेव हो जाते हैं।</string>
    <string name="hunt_rule_9">अभी संकेत और फेंटने में कोई चाल नहीं लगती।</string>
    <string name="hunt_rule_10">मिशन पूरा होने के बाद बची चालों से खोज जारी रखें।</string>
    <string name="hunt_scoring">स्कोरिंग</string>
    <string name="hunt_scoring_formula">स्कोर = 5 + 5A + 5E + R + S</string>
    <string name="hunt_scoring_legend">A = परमाणु · E = अलग-अलग तत्व · R = दुर्लभता (0–40) · S = नई खोजों की स्ट्रीक (0–15)</string>
    <string name="hunt_formula_note">सूत्र संरचना नहीं, बल्कि संघटन बताता है। जैसे, C₂H₆O एक से ज़्यादा पदार्थ हो सकता है।</string>
